# --- секреты: никогда не должны попасть в репозиторий ---
.env
.env.*
!.env.example
# Секреты Cloudflare для локального запуска функций
.dev.vars
supabase/.env

# --- зависимости ---
node_modules/

# --- сборка ---
dist/
dist-ssr/
build/
.cache/
*.local

# --- хостинг ---
.vercel/
.netlify/

# --- Supabase CLI ---
supabase/.branches/
supabase/.temp/

# --- временные файлы скриптов импорта ---
scripts/.tmp/

# --- редакторы ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- ОС ---
.DS_Store
Thumbs.db
desktop.ini

# --- логи ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- React Router typegen ---
.react-router/

# --- отметка о сборке: пересоздаётся при каждой сборке ---
public/build-info.json
