# Образец. Скопируйте нужное в свои файлы и подставьте значения.
#
# Здесь только ИМЕНА. Значений в этом файле быть не должно ни при каких
# обстоятельствах: он лежит в git, и всё, что сюда попало, достаётся
# из истории одной командой из любого клона. Однажды так уже уехал
# токен бота.
#
# Файлов три, и у каждого своя роль:
#
#   .env          то, что уезжает в браузер. Префикс VITE_ — требование
#                 Vite: без него переменная до клиента не доходит.
#   .dev.vars     то, чего браузер видеть не должен. Отдельным файлом,
#                 а не строкой в .env: иначе судьбу сервисного ключа
#                 решают пять символов префикса, которые легко забыть убрать.
#   .env.preview  адрес черновой выкладки. Отдельно потому, что должен
#                 действовать ТОЛЬКО в режиме preview — в .env он превратил
#                 бы и боевую сборку в черновик, молча и незаметно.
#
# Все три закрыты .gitignore. Как получить значения — database/README.md.

# --- .env ---------------------------------------------------------------
# Публичные по своей природе: анонимный ключ и так лежит в бандле у каждого
# посетителя, защищает базу не он, а RLS.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- .dev.vars ----------------------------------------------------------
# Секреты. В браузер не попадают никогда.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Обходит RLS полностью. НИКОГДА не давать ему префикс VITE_: с ним он уедет
# в бандл вместе с полным доступом к базе и ко всем заявкам.
SUPABASE_SERVICE_ROLE_KEY=

# Соль для отпечатка посетителя в счётчике. Любая длинная случайная строка.
# Нужна после того, как накачен database/analytics.sql.
TRACK_SALT=

# --- .env.preview -------------------------------------------------------

VITE_PREVIEW_URL=

# --- только на хостинге -------------------------------------------------
# Локально не нужны: сборку здесь никто не запускает по кнопке.

# Адрес сайта для ссылки на товар в сообщении бота.
SITE_URL=

# Секретный адрес сборки для кнопки «Опубликовать».
# Netlify: Site configuration → Build & deploy → Build hooks.
BUILD_HOOK_URL=
