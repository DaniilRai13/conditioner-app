# Скопировать в .env.local и заполнить. Сам .env.local в git не попадает.

# --- Supabase: публичные ключи ---
# Уезжают в клиентский бандл. Это безопасно ТОЛЬКО при включённом RLS на всех таблицах.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase: секретный ключ ---
# Обходит RLS полностью. Только скрипт импорта и serverless-функция /api/lead.
# НИКОГДА не добавлять префикс VITE_ — иначе ключ уедет в браузер.
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram: уведомления о заявках ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Хук пересборки для кнопки «Опубликовать изменения» в админке ---
BUILD_HOOK_URL=
